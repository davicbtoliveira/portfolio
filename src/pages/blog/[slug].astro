---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { findProjectForPost } from "../../lib/content-relationships";
import { listPosts } from "../../lib/blog-listing";
import { readingTime } from "../../lib/reading-time";
import type { PostEntry, ProjectEntry } from "../../content/schemas";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  const entries = posts.map((post) => ({
    id: post.id.replace(/\.mdx?$/, ""),
    data: post.data,
    entry: post,
  }));
  const listedIds = new Set(listPosts(entries).map((post) => post.id));
  return entries
    .filter((entry) => listedIds.has(entry.id))
    .map((entry) => ({
      params: { slug: entry.id },
      props: { post: entry.entry },
    }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const slug = post.id.replace(/\.mdx?$/, "");
const postEntry: PostEntry = { id: slug, data: post.data };
const projects = await getCollection("projects");
const projectEntries: ProjectEntry[] = projects.map((project) => ({
  id: project.id.replace(/\.mdx?$/, ""),
  data: project.data,
}));
const owningProject = findProjectForPost(postEntry, projectEntries);
const formatter = new Intl.DateTimeFormat("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
  timeZone: "UTC",
});
const published = formatter.format(post.data.pubDate);
const updated = post.data.updatedDate ? formatter.format(post.data.updatedDate) : undefined;
const minutes = readingTime(post.body ?? "");
---

<BaseLayout
  title={`${post.data.title} — Blog`}
  description={post.data.description}
  canonicalPath={`/blog/${slug}`}
  imagePath={`/og/blog-${slug}.png`}
  ogType="article"
>
  <article class="page post-detail">
    <header class="post-header">
      <p class="post-breadcrumb"><a href="/blog">blog</a> /</p>
      <h1 class="post-title">{post.data.title}</h1>
      <p class="post-description">{post.data.description}</p>
      <p class="post-meta">
        <time datetime={post.data.pubDate.toISOString()}>{published}</time>
        <span aria-hidden="true"> · </span>
        <span>{minutes}</span>
        {updated && <><span aria-hidden="true"> · </span><span>updated {updated}</span></>}
      </p>
      {
        post.data.tags.length > 0 && (
          <ul class="post-tags" aria-label="Tags">
            {post.data.tags.map((tag: string) => <li>{tag}</li>)}
          </ul>
        )
      }
      {
        owningProject && (
          <p class="project-badge">
            part of <a href={`/projects/${owningProject.id}`}>{owningProject.data.title}</a>
          </p>
        )
      }
    </header>

    <div class="prose">
      <Content />
    </div>
  </article>
</BaseLayout>

<style>
  .post-detail {
    padding-bottom: 5rem;
  }
  .post-header {
    margin-bottom: 2.5rem;
  }
  .post-breadcrumb {
    color: var(--color-muted);
    font-size: 0.75rem;
    margin: 0 0 0.75rem;
  }
  .post-breadcrumb a {
    color: var(--color-muted);
  }
  .post-breadcrumb a:hover {
    color: var(--color-accent);
  }
  .post-title {
    font-size: 1.75rem;
    font-weight: 500;
    line-height: 1.2;
    margin: 0 0 0.75rem;
    letter-spacing: -0.01em;
  }
  .post-description {
    color: var(--color-fg);
    font-size: 1rem;
    line-height: 1.6;
    margin: 0 0 0.75rem;
  }
  .post-meta {
    color: var(--color-muted);
    font-size: 0.75rem;
    margin: 0;
  }
  .post-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    list-style: none;
    margin: 0.75rem 0 0;
    padding: 0;
  }
  .post-tags li {
    border: 1px solid var(--color-border);
    font-size: 0.6875rem;
    padding: 0.15rem 0.45rem;
    color: var(--color-muted);
  }
  .project-badge {
    color: var(--color-muted);
    font-size: 0.75rem;
    margin: 0.75rem 0 0;
  }
  .prose {
    border-top: 1px solid var(--color-border);
    padding-top: 2rem;
    font-family: var(--font-serif);
    font-size: 1.0625rem;
    line-height: 1.75;
    color: var(--color-fg);
  }
  .prose :global(h2) {
    font-family: var(--font-mono);
    font-size: 1rem;
    font-weight: 500;
    margin: 2rem 0 0.75rem;
    color: var(--color-fg);
  }
  .prose :global(h3) {
    font-family: var(--font-mono);
    font-size: 0.9375rem;
    font-weight: 500;
    margin: 1.5rem 0 0.5rem;
    color: var(--color-fg);
  }
  .prose :global(p) {
    margin: 0 0 1rem;
  }
  .prose :global(a) {
    color: var(--color-blue);
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .prose :global(a:hover) {
    color: var(--color-accent);
  }
  .prose :global(code) {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    background: var(--color-border);
    padding: 0.1em 0.3em;
  }
  .prose :global(pre) {
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    padding: 1rem;
    overflow-x: auto;
    font-size: 0.8125rem;
    line-height: 1.5;
    margin: 1rem 0;
  }
  .prose :global(pre code) {
    background: none;
    padding: 0;
    font-size: inherit;
  }
  .prose :global(ul),
  .prose :global(ol) {
    margin: 0 0 1rem;
    padding-left: 1.25rem;
  }
  .prose :global(li) {
    margin: 0.25rem 0;
  }
  .prose :global(blockquote) {
    border-left: 3px solid var(--color-accent);
    margin: 1rem 0;
    padding: 0.25rem 1rem;
    color: var(--color-muted);
  }
  .prose :global(hr) {
    margin: 1.5rem 0;
  }
  .prose :global(img) {
    max-width: 100%;
    border: 1px solid var(--color-border);
    margin: 1rem 0;
  }
  .prose :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin: 1rem 0;
    font-size: 0.875rem;
  }
  .prose :global(th),
  .prose :global(td) {
    border: 1px solid var(--color-border);
    padding: 0.5rem 0.75rem;
    text-align: left;
  }
  .prose :global(th) {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
</style>
