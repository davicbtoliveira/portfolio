---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { findProjectForPost } from "../../lib/content-relationships";
import { listPosts } from "../../lib/blog-listing";
import { readingTime } from "../../lib/reading-time";
import type { PostEntry, ProjectEntry } from "../../content/schemas";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  const entries = posts.map((post) => ({
    id: post.id.replace(/\.mdx?$/, ""),
    data: post.data,
    entry: post,
  }));
  const listedIds = new Set(listPosts(entries).map((post) => post.id));
  return entries
    .filter((entry) => listedIds.has(entry.id))
    .map((entry) => ({
      params: { slug: entry.id },
      props: { post: entry.entry },
    }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const slug = post.id.replace(/\.mdx?$/, "");
const postEntry: PostEntry = { id: slug, data: post.data };
const projects = await getCollection("projects");
const projectEntries: ProjectEntry[] = projects.map((project) => ({
  id: project.id.replace(/\.mdx?$/, ""),
  data: project.data,
}));
const owningProject = findProjectForPost(postEntry, projectEntries);
const formatter = new Intl.DateTimeFormat("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
  timeZone: "UTC",
});
const published = formatter.format(post.data.pubDate);
const updated = post.data.updatedDate ? formatter.format(post.data.updatedDate) : undefined;
const minutes = readingTime(post.body ?? "");
---

<BaseLayout
  title={`${post.data.title} — Blog`}
  description={post.data.description}
  canonicalPath={`/blog/${slug}`}
  imagePath={`/og/blog-${slug}.png`}
  ogType="article"
>
  <main class="post-detail">
    <header>
      <p class="eyebrow">Blog</p>
      <h1>{post.data.title}</h1>
      <p class="description">{post.data.description}</p>
      <p class="meta">
        <time datetime={post.data.pubDate.toISOString()}>{published}</time>
        <span>·</span>
        <span>{minutes}</span>
        {updated && <span>· Updated {updated}</span>}
      </p>
      <ul class="tags" aria-label="Tags">
        {post.data.tags.map((tag: string) => <li>{tag}</li>)}
      </ul>
      {
        owningProject && (
          <p class="project-badge">
            Part of project{" "}
            <a href={`/projects/${owningProject.id}`}>{owningProject.data.title}</a>
          </p>
        )
      }
    </header>

    <article class="prose">
      <Content />
    </article>
  </main>
</BaseLayout>

<style>
  .post-detail {
    max-width: 48rem;
    margin: 0 auto;
    padding: 4rem 1.5rem;
  }
  .eyebrow {
    color: var(--color-accent);
    font-family: var(--font-mono);
    font-size: 0.875rem;
    margin: 0 0 0.75rem;
  }
  h1 {
    font-size: clamp(2.5rem, 8vw, 4.5rem);
    line-height: 1.1;
    margin: 0 0 1rem;
  }
  .description {
    color: var(--color-fg);
    font-size: 1.25rem;
    line-height: 1.7;
    margin: 0 0 1rem;
  }
  .meta {
    align-items: center;
    color: var(--color-muted);
    display: flex;
    flex-wrap: wrap;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    gap: 0.5rem;
    margin: 0 0 1rem;
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    list-style: none;
    margin: 0 0 1rem;
    padding: 0;
  }
  .tags li {
    border: 1px solid var(--color-border);
    border-radius: 999px;
    color: var(--color-muted);
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    padding: 0.25rem 0.6rem;
  }
  .project-badge {
    color: var(--color-muted);
    margin: 0 0 3rem;
  }
  a {
    color: var(--color-accent);
  }
  .prose {
    border-top: 1px solid var(--color-border);
    color: var(--color-muted);
    line-height: 1.8;
    padding-top: 2rem;
  }
</style>
