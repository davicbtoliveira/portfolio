---
import BaseLayout from "../../layouts/BaseLayout.astro";
import BlogCard from "../../components/BlogCard.astro";
import { getPostEntries, getPostTags } from "../../lib/posts";

const tag = Astro.url.searchParams.get("tag") ?? undefined;
const posts = await getPostEntries({ tag });
const tags = await getPostTags();
---

<BaseLayout
  title="Blog — Davi Oliveira"
  description="Technical posts by Davi Oliveira in reverse chronological order."
>
  <div class="page">
    <h1 class="section-heading">Blog</h1>
    <p class="page-desc">
      Technical notes, project write-ups, and implementation decisions.
    </p>

    <nav aria-label="Blog tags" class="filters">
      <a href="/blog" class:list={{ active: !tag }}>all</a>
      {tags.map((item) => (
        <a href={`/blog?tag=${item}`} class:list={{ active: tag === item }}>{item}</a>
      ))}
    </nav>

    {
      posts.length > 0 ? (
        <div>
          {posts.map((entry) => (
            <BlogCard post={entry.data} href={`/blog/${entry.id}`} />
          ))}
        </div>
      ) : (
        <p class="empty">no posts match this tag</p>
      )
    }
  </div>
</BaseLayout>

<style>
  .page-desc {
    color: var(--color-muted);
    font-size: 0.9375rem;
    margin: -0.75rem 0 1.5rem;
  }
  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 1.5rem;
  }
  .filters a {
    color: var(--color-muted);
    font-size: 0.75rem;
    padding: 0.2rem 0.5rem;
    border: 1px solid var(--color-border);
    text-decoration: none;
    transition: color 150ms ease-out, border-color 150ms ease-out;
  }
  .filters a:hover,
  .filters a.active {
    color: var(--color-accent);
    border-color: var(--color-accent);
  }
  .empty {
    color: var(--color-muted);
    font-size: 0.875rem;
    border: 1px solid var(--color-border);
    padding: 1rem;
  }
</style>
