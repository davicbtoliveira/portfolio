---
import BaseLayout from "../../layouts/BaseLayout.astro";
import BlogCard from "../../components/BlogCard.astro";
import { getPostEntries, getPostTags } from "../../lib/posts";

const tag = Astro.url.searchParams.get("tag") ?? undefined;
const posts = await getPostEntries({ tag });
const tags = await getPostTags();
---

<BaseLayout
  title="Blog — Davi Oliveira"
  description="Technical posts by Davi Oliveira in reverse chronological order."
>
  <main class="blog-page">
    <header class="page-header">
      <p class="eyebrow">Blog</p>
      <h1>Blog</h1>
      <p>Technical notes, project write-ups, and implementation decisions.</p>
    </header>

    <nav aria-label="Blog tags" class="filters">
      <a href="/blog">All</a>
      {tags.map((item) => <a href={`/blog?tag=${item}`}>{item}</a>)}
    </nav>

    {
      posts.length > 0 ? (
        <div class="list">
          {posts.map((entry) => (
            <BlogCard post={entry.data} href={`/blog/${entry.id}`} />
          ))}
        </div>
      ) : (
        <p class="empty">No posts match this tag.</p>
      )
    }
  </main>
</BaseLayout>

<style>
  .blog-page {
    max-width: 48rem;
    margin: 0 auto;
    padding: 4rem 1.5rem;
  }
  .page-header {
    margin-bottom: 2rem;
  }
  .eyebrow {
    color: var(--color-accent);
    font-family: var(--font-mono);
    font-size: 0.875rem;
    margin: 0 0 0.75rem;
  }
  h1 {
    font-size: clamp(2.5rem, 8vw, 4.5rem);
    line-height: 1.1;
    margin: 0 0 1rem;
  }
  p {
    color: var(--color-muted);
    line-height: 1.7;
    margin: 0;
  }
  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-bottom: 2rem;
  }
  .filters a {
    border: 1px solid var(--color-border);
    border-radius: 999px;
    color: var(--color-muted);
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    padding: 0.35rem 0.7rem;
    text-decoration: none;
  }
  .filters a:hover,
  .filters a:focus-visible {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }
  .list {
    display: grid;
    gap: 1rem;
  }
  .empty {
    border: 1px solid var(--color-border);
    border-radius: 0.5rem;
    padding: 1.25rem;
  }
</style>
