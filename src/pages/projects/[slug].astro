---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { findRelatedPosts } from "../../lib/content-relationships";
import type { PostEntry, ProjectEntry } from "../../content/schemas";

export async function getStaticPaths() {
  const projects = await getCollection("projects");
  return projects.map((project) => ({
    params: { slug: project.id.replace(/\.mdx?$/, "") },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);
const slug = project.id.replace(/\.mdx?$/, "");
const projectEntry: ProjectEntry = { id: slug, data: project.data };
const posts = await getCollection("blog");
const postEntries: PostEntry[] = posts.map((post) => ({
  id: post.id.replace(/\.mdx?$/, ""),
  data: post.data,
}));
const relatedPosts = findRelatedPosts(projectEntry, postEntries);
---

<BaseLayout
  title={`${project.data.title} — Projects`}
  description={project.data.summary}
  canonicalPath={`/projects/${slug}`}
  imagePath={`/og/project-${slug}.png`}
>
  <article class="page project-detail">
    <header class="project-header">
      <p class="project-breadcrumb"><a href="/projects">projects</a> /</p>
      <h1 class="project-title">{project.data.title}</h1>
      <p class="project-summary">{project.data.summary}</p>

      <dl class="project-meta">
        <div>
          <dt>year</dt>
          <dd>{project.data.year}</dd>
        </div>
        <div>
          <dt>status</dt>
          <dd>{project.data.status}</dd>
        </div>
        <div>
          <dt>role</dt>
          <dd>{project.data.role}</dd>
        </div>
        <div>
          <dt>tech</dt>
          <dd>{project.data.tech.join(", ")}</dd>
        </div>
      </dl>

      <div class="project-links">
        {project.data.links.repo && <a href={project.data.links.repo}>repo</a>}
        {project.data.links.demo && <a href={project.data.links.demo}>demo</a>}
        {project.data.links.post && <a href={project.data.links.post}>post</a>}
      </div>
    </header>

    <div class="prose">
      <Content />
    </div>

    {
      relatedPosts.length > 0 && (
        <section class="related" aria-labelledby="related-heading">
          <h2 id="related-heading" class="section-heading">Articles</h2>
          <ul class="related-list">
            {relatedPosts.map((post) => (
              <li>
                <a href={`/blog/${post.id}`}>{post.data.title}</a>
              </li>
            ))}
          </ul>
        </section>
      )
    }
  </article>
</BaseLayout>

<style>
  .project-detail {
    padding-bottom: 5rem;
  }
  .project-header {
    margin-bottom: 2.5rem;
  }
  .project-breadcrumb {
    color: var(--color-muted);
    font-size: 0.75rem;
    margin: 0 0 0.75rem;
  }
  .project-breadcrumb a {
    color: var(--color-muted);
  }
  .project-breadcrumb a:hover {
    color: var(--color-accent);
  }
  .project-title {
    font-size: 1.75rem;
    font-weight: 500;
    line-height: 1.2;
    margin: 0 0 0.75rem;
    letter-spacing: -0.01em;
  }
  .project-summary {
    color: var(--color-fg);
    font-size: 1rem;
    line-height: 1.6;
    margin: 0 0 1.5rem;
  }
  .project-meta {
    display: grid;
    gap: 0.5rem 1.5rem;
    grid-template-columns: repeat(auto-fit, minmax(8rem, 1fr));
    margin: 0 0 1rem;
  }
  .project-meta dt {
    color: var(--color-muted);
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-bottom: 0.1rem;
  }
  .project-meta dd {
    margin: 0;
    font-size: 0.875rem;
  }
  .project-links {
    display: flex;
    gap: 0.75rem;
    margin-bottom: 0;
  }
  .project-links a {
    font-size: 0.8125rem;
  }
  .prose {
    border-top: 1px solid var(--color-border);
    padding-top: 2rem;
    font-family: var(--font-serif);
    font-size: 1.0625rem;
    line-height: 1.75;
    color: var(--color-fg);
  }
  .prose :global(h2) {
    font-family: var(--font-mono);
    font-size: 1rem;
    font-weight: 500;
    margin: 2rem 0 0.75rem;
    color: var(--color-fg);
  }
  .prose :global(h3) {
    font-family: var(--font-mono);
    font-size: 0.9375rem;
    font-weight: 500;
    margin: 1.5rem 0 0.5rem;
    color: var(--color-fg);
  }
  .prose :global(p) {
    margin: 0 0 1rem;
  }
  .prose :global(a) {
    color: var(--color-blue);
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .prose :global(a:hover) {
    color: var(--color-accent);
  }
  .prose :global(code) {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    background: var(--color-border);
    padding: 0.1em 0.3em;
  }
  .prose :global(pre) {
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    padding: 1rem;
    overflow-x: auto;
    font-size: 0.8125rem;
    line-height: 1.5;
    margin: 1rem 0;
  }
  .prose :global(pre code) {
    background: none;
    padding: 0;
    font-size: inherit;
  }
  .prose :global(ul),
  .prose :global(ol) {
    margin: 0 0 1rem;
    padding-left: 1.25rem;
  }
  .prose :global(li) {
    margin: 0.25rem 0;
  }
  .related {
    border-top: 1px solid var(--color-border);
    margin-top: 3rem;
    padding-top: 2rem;
  }
  .related-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .related-list li + li {
    margin-top: 0.5rem;
  }
</style>
