---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ProjectCard from "../../components/ProjectCard.astro";
import { getProjectEntries } from "../../lib/projects";

const statusParam = Astro.url.searchParams.get("status") ?? undefined;
const techParam = Astro.url.searchParams.get("tech") ?? undefined;
const status =
  statusParam === "active" ||
  statusParam === "maintained" ||
  statusParam === "archived" ||
  statusParam === "wip"
    ? statusParam
    : undefined;

const projects = await getProjectEntries({ status, tech: techParam });
const allProjects = await getProjectEntries();
const statuses = Array.from(new Set(allProjects.map((entry) => entry.data.status))).sort();
const techs = Array.from(
  new Set(allProjects.flatMap((entry) => entry.data.tech)),
).sort();
---

<BaseLayout
  title="Projects — Davi Oliveira"
  description="A browsable index of projects by Davi Oliveira."
>
  <main class="projects-page">
    <header class="page-header">
      <p class="eyebrow">Projects</p>
      <h1>Projects</h1>
      <p>
        OSS and personal work, listed with status, role, stack, and available
        links.
      </p>
    </header>

    <nav aria-label="Project filters" class="filters">
      <a href="/projects">All</a>
      {statuses.map((item) => <a href={`/projects?status=${item}`}>{item}</a>)}
      {techs.map((item) => <a href={`/projects?tech=${item}`}>{item}</a>)}
    </nav>

    {
      projects.length > 0 ? (
        <div class="grid">
          {projects.map((entry) => (
            <ProjectCard
              project={entry.data}
              href={`/projects/${entry.id}`}
              stats={entry.stats}
            />
          ))}
        </div>
      ) : (
        <p class="empty">No projects match this filter.</p>
      )
    }
  </main>
</BaseLayout>

<style>
  .projects-page {
    max-width: 64rem;
    margin: 0 auto;
    padding: 4rem 1.5rem;
  }
  .page-header {
    max-width: 44rem;
    margin-bottom: 2rem;
  }
  .eyebrow {
    color: var(--color-accent);
    font-family: var(--font-mono);
    font-size: 0.875rem;
    margin: 0 0 0.75rem;
  }
  h1 {
    font-size: clamp(2.5rem, 8vw, 4.5rem);
    line-height: 1.1;
    margin: 0 0 1rem;
  }
  p {
    color: var(--color-muted);
    line-height: 1.7;
    margin: 0;
  }
  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-bottom: 2rem;
  }
  .filters a {
    border: 1px solid var(--color-border);
    border-radius: 999px;
    color: var(--color-muted);
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    padding: 0.35rem 0.7rem;
    text-decoration: none;
  }
  .filters a:hover,
  .filters a:focus-visible {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }
  .grid {
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(auto-fill, minmax(18rem, 1fr));
  }
  .empty {
    border: 1px solid var(--color-border);
    border-radius: 0.5rem;
    padding: 1.25rem;
  }
</style>
