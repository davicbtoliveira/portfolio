---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="About — Davi Oliveira"
  description="Background, stack, OSS work, and contact for Davi Oliveira."
>
  <div class="page">
    <h1 class="section-heading">About</h1>
    <p class="lead">
      I build backend software focused on maintainability, reliability, and
      performance.
    </p>

    <hr class="section-divider" />

    <section>
      <h2 class="section-heading">Stack</h2>
      <p class="body-text">
        Go, Python, PHP, Node.js, TypeScript, PostgreSQL, Linux, and
        Cloudflare.
      </p>
      <p class="body-text">
        I prefer small modules, content-first interfaces, and production paths
        that can be explained without ceremony.
      </p>
    </section>

    <hr class="section-divider" />

    <section>
      <h2 class="section-heading">OSS</h2>
      <p class="body-text">
        My OSS work focuses on developer tooling, portfolio infrastructure, and
        practical automation that removes repeated manual work.
      </p>
    </section>

    <hr class="section-divider" />

    <section>
      <h2 class="section-heading">Contact</h2>
      <div class="contact-links">
        <a href="mailto:davicbtoliveira@gmail.com">email</a>
        <a href="https://linkedin.com/in/dcbto">linkedin</a>
        <a href="https://github.com/davicbtoliveira">github</a>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .lead {
    font-size: 1.0625rem;
    color: var(--color-fg);
    line-height: 1.6;
    margin: 0;
  }
  .body-text {
    color: var(--color-muted);
    line-height: 1.7;
    margin: 0;
  }
  .body-text + .body-text {
    margin-top: 1rem;
  }
  .contact-links {
    display: flex;
    gap: 1rem;
  }
</style>
