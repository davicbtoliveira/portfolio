---
import BaseLayout from "../layouts/BaseLayout.astro";

const name = "Davi Oliveira";
const description = "Crio software minimalista, com atenção aos detalhes.";
---

<BaseLayout
  title={`${name} — software minimalista`}
  description={`${name} — ${description}`}
  showChrome={false}
>
  <div class="messenger-page">
    <section class="messenger-window" aria-label={`Conversa com ${name}`} data-msn-chat>
      <header class="window-titlebar">
        <svg class="msn-icon" viewBox="0 0 32 28" aria-hidden="true">
          <path fill="#58b7e6" d="M15 14C6 13 2 8 4 3c5-2 10 1 12 7Z" />
          <path fill="#70c84b" d="M16 15c-7 4-12 3-14-1 2-5 8-6 14-3Z" />
          <path fill="#f5bd3e" d="M17 14c2-8 7-11 11-9 2 5-2 10-9 11Z" />
          <path fill="#ef7864" d="M17 16c7 0 11 4 10 8-5 2-10-2-11-7Z" />
          <circle cx="16" cy="15" r="2.5" fill="#fff" />
        </svg>
        <p>{name} &lt;davicbtoliveira@gmail.com&gt;</p>
        <div class="window-controls" aria-hidden="true"><i></i><i></i><i></i></div>
      </header>

      <div class="messenger-toolbar" aria-hidden="true">
        <span>Perfil</span><span>Arquivos</span><span>Contato</span>
      </div>

      <div class="contact-bar">
        <div class="avatar" aria-hidden="true">DO</div>
        <div>
          <h1>{name} <span>(Disponível)</span></h1>
          <p>{description}</p>
        </div>
      </div>

      <div class="conversation" data-messages aria-live="polite">
        <p class="conversation-note">Use os links abaixo para me encontrar.</p>
        <article class="message message--received">
          <p class="message-meta">Davi diz:</p>
          <p class="message-line">• Olá.</p>
        </article>
        <article class="message message--received">
          <p class="message-meta">Davi diz:</p>
          <p class="message-line">• Eu sou {name}. {description}</p>
        </article>
      </div>

      <div class="choice-panel">
        <p>Escolha onde continuar:</p>
        <div class="choices" aria-label="Links de Davi">
          <button
            type="button"
            data-social-choice
            data-label="github"
            data-url="https://github.com/davicbtoliveira"
            data-domain="github.com/davicbtoliveira"
            data-title="GitHub · Davi Oliveira"
            data-copy="Projetos, experimentos e código aberto."
          >
            <svg class="social-icon" viewBox="0 0 24 24" aria-hidden="true">
              <path fill="currentColor" d="M12 .7a11.3 11.3 0 0 0-3.57 22.02c.56.1.77-.24.77-.54v-2.1c-3.13.68-3.79-1.33-3.79-1.33-.5-1.3-1.26-1.64-1.26-1.64-1.04-.7.08-.68.08-.68 1.15.08 1.75 1.17 1.75 1.17 1.02 1.75 2.68 1.25 3.33.96.1-.74.4-1.25.72-1.54-2.5-.28-5.13-1.25-5.13-5.57 0-1.23.44-2.23 1.16-3.02-.12-.28-.5-1.44.11-3 0 0 .95-.3 3.1 1.16A10.8 10.8 0 0 1 12 6.2c.96 0 1.93.13 2.83.38 2.16-1.46 3.1-1.16 3.1-1.16.62 1.56.23 2.72.12 3 .72.8 1.16 1.8 1.16 3.02 0 4.33-2.64 5.28-5.15 5.56.4.35.76 1.03.76 2.08v3.08c0 .3.2.65.78.54A11.3 11.3 0 0 0 12 .7Z" />
            </svg>
            github
          </button>
          <button
            type="button"
            data-social-choice
            data-label="linkedin"
            data-url="https://linkedin.com/in/dcbto"
            data-domain="linkedin.com/in/dcbto"
            data-title="LinkedIn · Davi Oliveira"
            data-copy="Experiência, trajetória e formas de trabalhar junto."
          >
            <svg class="social-icon" viewBox="0 0 24 24" aria-hidden="true">
              <path fill="currentColor" d="M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.13 1.45-2.13 2.94v5.67H9.35V8.98h3.42v1.57h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.26 2.37 4.26 5.46v6.29ZM5.34 7.42a2.07 2.07 0 1 1 0-4.14 2.07 2.07 0 0 1 0 4.14Zm1.78 13.03H3.56V8.98h3.56v11.47Z" />
            </svg>
            linkedin
          </button>
        </div>
      </div>
    </section>
    <p class="messenger-note">feito com cuidado, sem buzzwords</p>
  </div>
</BaseLayout>

<script is:inline>
  const chat = document.querySelector("[data-msn-chat]");

  if (chat) {
    const messages = chat.querySelector("[data-messages]");
    const choices = chat.querySelectorAll("[data-social-choice]");

    choices.forEach((choice) => {
      choice.addEventListener("click", () => {
        const { label, url, domain, title, copy } = choice.dataset;
        if (!label || !url || !domain || !title || !copy || !messages) return;

        const sent = document.createElement("article");
        sent.className = "message message--sent";
        sent.innerHTML = `<p class="message-meta">Você diz:</p><p class="message-line">• ${label}</p>`;

        const received = document.createElement("article");
        received.className = "message message--received message--link";
        received.innerHTML = `
          <p class="message-meta">Davi diz:</p>
          <p class="message-line">• Aqui está:</p>
          <a class="link-preview" href="${url}" target="_blank" rel="noreferrer">
            <span class="link-preview__accent"></span>
            <span class="link-preview__content">
              <strong>${title}</strong>
              <span>${copy}</span>
              <small>${domain}</small>
            </span>
            <span class="link-preview__open" aria-hidden="true">↗</span>
          </a>`;

        messages.append(sent, received);
        choice.setAttribute("aria-pressed", "true");
        choice.disabled = true;
        received.scrollIntoView({ behavior: "smooth", block: "nearest" });
      });
    });
  }
</script>

<style>
  :global(body) {
    background: #b7d7e8;
  }

  .messenger-page {
    --ink: #3e4b54;
    --blue: #199dd5;
    --line: #b9dbe9;
    min-height: 100vh;
    box-sizing: border-box;
    display: grid;
    place-items: center;
    padding: 2rem 1rem;
    background: linear-gradient(135deg, #d5edf8, #91c0db);
    color: var(--ink);
    font-family: Tahoma, "Trebuchet MS", Arial, sans-serif;
  }

  .messenger-window {
    width: min(100%, 57rem);
    overflow: hidden;
    border: 1px solid #5b9dc1;
    border-radius: 8px 8px 3px 3px;
    background: white;
    box-shadow:
      0 0 0 1px rgb(230 248 255 / 88%),
      0 0 0 2px rgb(42 104 151 / 56%),
      0 24px 60px rgb(27 65 87 / 32%),
      0 2px 0 rgb(255 255 255 / 82%) inset;
  }

  .window-titlebar {
    height: 1.95rem;
    display: flex;
    flex-shrink: 0;
    align-items: center;
    gap: 0.4rem;
    padding: 0 0.4rem;
    border-bottom: 1px solid #6da8cb;
    background: linear-gradient(#effaff 0%, #c5e7f8 43%, #8bc6e8 48%, #b1ddf2 100%);
    color: #26455c;
  }

  .window-titlebar p {
    flex: 1;
    margin: 0;
    font-size: 0.74rem;
    font-weight: bold;
  }

  .msn-icon { width: 1.15rem; height: 1rem; flex: 0 0 auto; filter: drop-shadow(0 1px rgb(255 255 255 / 75%)); }
  .window-controls { display: flex; align-self: stretch; gap: 1px; }
  .window-controls i { display: grid; width: 1.8rem; box-sizing: border-box; place-items: center; border: 1px solid #7daac4; border-top: 0; background: linear-gradient(#e7f7ff, #9ed0eb); color: #315f7c; font-family: Arial, sans-serif; font-size: 0.74rem; font-style: normal; text-shadow: 0 1px white; }
  .window-controls i::after { content: "—"; margin-top: -0.22rem; }
  .window-controls i:nth-child(2)::after { content: "□"; margin-top: -0.1rem; font-size: 0.69rem; }
  .window-controls i:last-child { background: linear-gradient(#edaaa5, #c9504b); border-color: #bd7773; color: white; text-shadow: 0 1px #93433e; }
  .window-controls i:last-child::after { content: "×"; margin-top: -0.08rem; font-size: 1rem; }

  .messenger-toolbar {
    display: flex;
    gap: 2rem;
    padding: 0.45rem 1rem;
    border-bottom: 1px solid #238fc3;
    background: linear-gradient(#48bce9, #1197d1);
    color: white;
    font-size: 0.78rem;
    text-shadow: 0 1px #197ca8;
  }

  .contact-bar {
    display: flex;
    flex-shrink: 0;
    align-items: center;
    gap: 1.1rem;
    min-height: 7.5rem;
    padding: 1.25rem 2rem;
    border-bottom: 1px solid #d0e1e9;
    background: linear-gradient(155deg, #f5fcff 5%, #d9f0fa 53%, #a1d7ee 54%, #e3f5fb 100%);
  }

  .avatar {
    display: grid;
    place-items: center;
    width: 6.25rem;
    height: 6.25rem;
    box-sizing: border-box;
    border: 4px solid #73cf42;
    border-radius: 18px;
    color: #eef8ff;
    font-weight: bold;
    font-size: 1.1rem;
    background: linear-gradient(135deg, #a7d3e3, #527e95);
    box-shadow: 0 0 0 2px white, 0 5px 10px rgb(36 101 74 / 25%);
  }

  .contact-bar h1 { margin: 0; color: #42505a; font-size: 1.45rem; font-weight: normal; line-height: 1.2; }
  .contact-bar h1 span { font-size: 0.85rem; }
  .contact-bar p { margin: 0.3rem 0 0; color: #44535e; font-size: 0.9rem; }

  .conversation { min-height: 16rem; max-height: 25rem; overflow-y: auto; padding: 1.1rem 2rem 1.5rem 14.8rem; background: white; }
  .conversation-note { margin: 0 0 1.35rem; padding-bottom: 0.55rem; border-bottom: 1px solid #c6d6dd; color: #63737e; font-size: 0.79rem; }
  .message { margin-top: 0.6rem; }
  .message:first-of-type { margin-top: 0; }
  .message-meta { margin: 0; color: #6a747b; font-size: 0.88rem; }
  .message-line { margin: 0.12rem 0 0; padding-left: 0.38rem; color: #3f4b53; font-size: 0.95rem; line-height: 1.45; }
  .message--sent .message-meta { color: #42728d; }

  .link-preview { width: min(100%, 28rem); box-sizing: border-box; display: flex; gap: 0.75rem; overflow: hidden; margin: 0.45rem 0 0 0.35rem; border: 1px solid #c5d7e8; border-radius: 2px; background: #f9fcff; color: #254b7f; text-decoration: none; box-shadow: 0 2px 5px rgb(30 73 118 / 10%); transition: transform 140ms ease, box-shadow 140ms ease; }
  .link-preview:hover { color: #254b7f; transform: translateY(-1px); box-shadow: 0 5px 10px rgb(30 73 118 / 16%); }
  .link-preview__accent { width: 4px; flex: 0 0 auto; background: #39a3d6; }
  .link-preview__content { min-width: 0; display: grid; gap: 0.18rem; padding: 0.7rem 0; }
  .link-preview strong { font-size: 0.83rem; }
  .link-preview span { color: #57728f; font-size: 0.75rem; line-height: 1.35; }
  .link-preview small { color: #7690a9; font-size: 0.68rem; }
  .link-preview__open { padding: 0.65rem 0.7rem 0 0; color: #5786b7; font-size: 1rem; }

  .choice-panel { flex-shrink: 0; padding: 0.85rem 2rem 1rem 14.8rem; border-top: 1px solid var(--line); background: #f7fcff; }
  .choice-panel p { margin: 0 0 0.55rem; color: #537596; font-size: 0.76rem; }
  .choices { display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .choices button { display: inline-flex; align-items: center; gap: 0.35rem; border: 1px solid #89b5df; border-radius: 4px; padding: 0.45rem 0.7rem; background: linear-gradient(#fff, #e6f3fe); color: #24578e; cursor: pointer; font: 700 0.8rem "Trebuchet MS", Arial, sans-serif; transition: border-color 140ms ease, background 140ms ease, transform 140ms ease; }
  .choices button:hover { border-color: #477fb9; background: #d7ebfb; transform: translateY(-1px); }
  .choices button:disabled { cursor: default; opacity: 0.52; transform: none; }
  .social-icon { width: 0.95rem; height: 0.95rem; flex: 0 0 auto; color: #1f78bd; }
  .messenger-note { margin: 0.75rem 0 0; color: #396f9e; font: 0.69rem "DM Mono", ui-monospace, monospace; text-align: center; }

  @media (max-width: 32rem) {
    .messenger-page { padding: 0; place-items: start stretch; }
    .messenger-window { width: 100%; min-height: 100vh; display: flex; flex-direction: column; border: 0; border-radius: 0; }
    .messenger-toolbar { gap: 1.2rem; }
    .contact-bar { min-height: 5rem; padding: 0.85rem 1rem; }
    .avatar { width: 4.3rem; height: 4.3rem; border-radius: 12px; font-size: 0.8rem; }
    .contact-bar h1 { font-size: 1.1rem; }
    .contact-bar p { font-size: 0.78rem; }
    .conversation { min-height: 0; max-height: none; flex: 1; padding: 1rem; }
    .choice-panel { padding: 0.85rem 1rem 1rem; }
    .messenger-note { display: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    .link-preview, .choices button { transition: none; }
  }
</style>
