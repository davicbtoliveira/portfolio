---
import BaseLayout from "../layouts/BaseLayout.astro";
import DesktopIcons from "../components/DesktopIcons.astro";

const name = "Davi Oliveira";
const description = "Crio software minimalista, com atenção aos detalhes.";
---

<BaseLayout
  title={`${name} — software minimalista`}
  description={`${name} — ${description}`}
  faviconPath="/msn-messenger.svg"
  lang="pt-BR"
  showChrome={false}
>
  <div class="messenger-page">
    <DesktopIcons />
    <section class="messenger-window" aria-label={`Conversa com ${name}`} data-i18n-attr="aria-label:windowAriaLabel" data-msn-chat>
      <header class="window-titlebar">
        <img class="msn-icon" src="/msn-messenger.svg" alt="" aria-hidden="true" data-messenger-icon />
        <p>{name} — Conversa</p>
        <div class="window-controls" aria-hidden="true"><i></i><i></i><i></i></div>
      </header>

      <div class="messenger-surface">
        <div class="messenger-toolbar" aria-hidden="true">
          <span data-i18n="toolbarFotos">Fotos</span><span data-i18n="toolbarArquivos">Arquivos</span><span data-i18n="toolbarVideo">Vídeo</span><span data-i18n="toolbarLigar">Ligar</span><span data-i18n="toolbarJogos">Jogos</span><span data-i18n="toolbarAtividades">Atividades</span><span>»</span>
        </div>

        <div class="contact-bar">
          <div class="avatar avatar--contact" aria-hidden="true">DO</div>
          <div>
            <h1>{name} <span data-i18n="statusAvail">(Disponível)</span></h1>
            <p data-i18n="description">{description}</p>
          </div>
        </div>

        <div class="chat-workspace">
          <aside class="profile-rail" aria-hidden="true">
            <span class="rail-handle">‹</span>
            <div class="avatar avatar--self"><span></span></div>
          </aside>

          <div class="chat-column">
            <div class="conversation" data-messages aria-live="polite">
              <p class="conversation-note">Use os links abaixo para me encontrar.</p>
              <article class="message message--received">
                <p class="message-meta" data-i18n="daviSays">Davi diz:</p>
                <p class="message-line" data-i18n="hello">Olá.</p>
              </article>
              <article class="message message--received">
                <p class="message-meta" data-i18n="daviSays">Davi diz:</p>
                <p class="message-line" data-i18n="intro">Eu sou {name}. {description}</p>
              </article>
            </div>

            <div class="choice-panel">
              <div class="composer-field">
                <p data-i18n="choose">Escolha onde continuar:</p>
                <div class="choices" aria-label="Links de Davi">
                  <button
                    type="button"
                    data-social-choice
                    data-social="github"
                    data-label="github"
                    data-url="https://github.com/davicbtoliveira"
                    data-domain="github.com/davicbtoliveira"
                    data-title="GitHub · Davi Oliveira"
                    data-copy="Projetos, experimentos e código aberto."
                  >
                    <svg class="social-icon" viewBox="0 0 24 24" aria-hidden="true">
                      <path fill="currentColor" d="M12 .7a11.3 11.3 0 0 0-3.57 22.02c.56.1.77-.24.77-.54v-2.1c-3.13.68-3.79-1.33-3.79-1.33-.5-1.3-1.26-1.64-1.26-1.64-1.04-.7.08-.68.08-.68 1.15.08 1.75 1.17 1.75 1.17 1.02 1.75 2.68 1.25 3.33.96.1-.74.4-1.25.72-1.54-2.5-.28-5.13-1.25-5.13-5.57 0-1.23.44-2.23 1.16-3.02-.12-.28-.5-1.44.11-3 0 0 .95-.3 3.1 1.16A10.8 10.8 0 0 1 12 6.2c.96 0 1.93.13 2.83.38 2.16-1.46 3.1-1.16 3.1-1.16.62 1.56.23 2.72.12 3 .72.8 1.16 1.8 1.16 3.02 0 4.33-2.64 5.28-5.15 5.56.4.35.76 1.03.76 2.08v3.08c0 .3.2.65.78.54A11.3 11.3 0 0 0 12 .7Z" />
                    </svg>
                    <span data-i18n="labelGithub">github</span>
                  </button>
                  <button
                    type="button"
                    data-social-choice
                    data-social="linkedin"
                    data-label="linkedin"
                    data-url="https://linkedin.com/in/dcbto"
                    data-domain="linkedin.com/in/dcbto"
                    data-title="LinkedIn · Davi Oliveira"
                    data-copy="Experiência, trajetória e formas de trabalhar junto."
                  >
                    <svg class="social-icon" viewBox="0 0 24 24" aria-hidden="true">
                      <path fill="currentColor" d="M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.13 1.45-2.13 2.94v5.67H9.35V8.98h3.42v1.57h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.26 2.37 4.26 5.46v6.29ZM5.34 7.42a2.07 2.07 0 1 1 0-4.14 2.07 2.07 0 0 1 0 4.14Zm1.78 13.03H3.56V8.98h3.56v11.47Z" />
                    </svg>
                    <span data-i18n="labelLinkedin">linkedin</span>
                  </button>
                  <button
                    type="button"
                    data-social-choice
                    data-social="contato"
                    data-label="contato"
                    data-url="mailto:davicbtoliveira@gmail.com"
                    data-domain="davicbtoliveira@gmail.com"
                    data-title="davicbtoliveira@gmail.com"
                    data-copy="Envie uma mensagem por e-mail."
                  >
                    <svg class="social-icon" viewBox="0 0 24 24" aria-hidden="true">
                      <path fill="currentColor" d="M3 5h18a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V7a2 2 0 0 1 2-2Zm9 7.2L20.1 7H3.9L12 12.2Zm0 2.4L3 8.8V17h18V8.8l-9 5.8Z" />
                    </svg>
                    <span data-i18n="labelContato">contato</span>
                  </button>
                </div>
              </div>
              <div class="composer-toolbar" aria-hidden="true">
                <span>☺</span><span class="composer-font">A</span><span>▧</span><span>♫</span>
              </div>
            </div>
          </div>
        </div>

        <footer class="messenger-statusbar">
          <span>Windows Live Messenger</span>
          <span data-i18n="statusbar">© Davi Oliveira. Nenhum direito reservado.</span>
        </footer>
      </div>
    </section>

    <div class="win7-taskbar" aria-hidden="true">
      <span class="start-orb">
        <svg viewBox="0 0 48 48" xmlns="http://www.w3.org/2000/svg">
          <defs>
            <radialGradient id="orbGrad" cx="36%" cy="28%" r="68%">
              <stop offset="0%" stop-color="#bef28c"/>
              <stop offset="10%" stop-color="#7cd654"/>
              <stop offset="30%" stop-color="#35a6b0"/>
              <stop offset="55%" stop-color="#0d7096"/>
              <stop offset="80%" stop-color="#064565"/>
              <stop offset="100%" stop-color="#032a3f"/>
            </radialGradient>
            <radialGradient id="highlightGrad" cx="28%" cy="20%" r="60%">
              <stop offset="0%" stop-color="#ffffff" stop-opacity="0.65"/>
              <stop offset="30%" stop-color="#ffffff" stop-opacity="0.15"/>
              <stop offset="100%" stop-color="#ffffff" stop-opacity="0"/>
            </radialGradient>
            <radialGradient id="shadowGrad" cx="50%" cy="50%" r="50%">
              <stop offset="78%" stop-color="#000000" stop-opacity="0"/>
              <stop offset="92%" stop-color="#000000" stop-opacity="0.08"/>
              <stop offset="100%" stop-color="#000000" stop-opacity="0.3"/>
            </radialGradient>
          </defs>
          <circle cx="24" cy="24" r="22" fill="url(#orbGrad)" stroke="rgba(233,252,255,0.5)" stroke-width="1"/>
          <circle cx="24" cy="24" r="22" fill="url(#shadowGrad)"/>
          <g transform="translate(14, 14) skewY(-7)">
            <rect x="0" y="0" width="6" height="6" fill="#E74B2C"/>
            <rect x="7.5" y="0" width="6" height="6" fill="#7CC347"/>
            <rect x="0" y="7.5" width="6" height="6" fill="#41A5DE"/>
            <rect x="7.5" y="7.5" width="6" height="6" fill="#FDDC4C"/>
          </g>
          <circle cx="24" cy="24" r="22" fill="url(#highlightGrad)"/>
        </svg>
      </span>
      <span class="taskbar-app">
        <img class="taskbar-app__icon" src="/msn-messenger.svg" alt="" />
        <span>{name}</span>
      </span>
      <button type="button" class="taskbar-tray" data-lang-toggle aria-label="Alternar idioma">PT</button>
    </div>
  </div>
</BaseLayout>

<script is:inline>
  const name = "Davi Oliveira";
  const descriptionPt = "Crio software minimalista, com atenção aos detalhes.";
  const descriptionEn = "I build minimalist software, with attention to detail.";

  const i18n = {
    pt: {
      htmlLang: "pt-BR",
      title: name + " — software minimalista",
      windowAriaLabel: "Conversa com " + name,
      statusAvail: "(Disponível)",
      description: descriptionPt,
      contactUpdate: "3 formas de contato disponíveis",
      daviSays: "Davi diz:",
      youSays: "Você diz:",
      hello: "Olá.",
      intro: "Eu sou " + name + ". " + descriptionPt,
      choose: "Escolha onde continuar:",
      labelGithub: "github",
      labelLinkedin: "linkedin",
      labelContato: "contato",
      statusbar: "© Davi Oliveira. Nenhum direito reservado.",
      hereIs: "Aqui está:",
      toolbarFotos: "Fotos",
      toolbarArquivos: "Arquivos",
      toolbarVideo: "Vídeo",
      toolbarLigar: "Ligar",
      toolbarJogos: "Jogos",
      toolbarAtividades: "Atividades",
      social: {
        github: { copy: "Projetos, experimentos e código aberto.", title: "GitHub · Davi Oliveira" },
        linkedin: { copy: "Experiência, trajetória e formas de trabalhar junto.", title: "LinkedIn · Davi Oliveira" },
        contato: { copy: "Envie uma mensagem por e-mail.", title: "davicbtoliveira@gmail.com" },
      },
    },
    en: {
      htmlLang: "en",
      title: name + " — minimalist software",
      windowAriaLabel: "Chat with " + name,
      statusAvail: "(Available)",
      description: descriptionEn,
      contactUpdate: "3 ways to get in touch",
      daviSays: "Davi says:",
      youSays: "You say:",
      hello: "Hello.",
      intro: "I'm " + name + ". " + descriptionEn,
      choose: "Choose where to continue:",
      labelGithub: "github",
      labelLinkedin: "linkedin",
      labelContato: "contact",
      statusbar: "© Davi Oliveira. No rights reserved.",
      hereIs: "Here it is:",
      toolbarFotos: "Photos",
      toolbarArquivos: "Files",
      toolbarVideo: "Video",
      toolbarLigar: "Call",
      toolbarJogos: "Games",
      toolbarAtividades: "Activities",
      social: {
        github: { copy: "Projects, experiments and open source.", title: "GitHub · Davi Oliveira" },
        linkedin: { copy: "Experience, background and ways to work together.", title: "LinkedIn · Davi Oliveira" },
        contato: { copy: "Send me an email.", title: "davicbtoliveira@gmail.com" },
      },
    },
  };

  let currentLang = "pt";

  function applyLang(lang) {
    const dict = i18n[lang] || i18n.pt;
    currentLang = lang;
    document.documentElement.lang = dict.htmlLang;
    document.documentElement.dataset.lang = lang;
    document.title = dict.title;

    document.querySelectorAll("[data-i18n]").forEach((el) => {
      const key = el.dataset.i18n;
      if (Object.prototype.hasOwnProperty.call(dict, key)) el.textContent = dict[key];
    });

    document.querySelectorAll("[data-i18n-attr]").forEach((el) => {
      el.dataset.i18nAttr.split(",").forEach((spec) => {
        const [attr, key] = spec.split(":");
        if (Object.prototype.hasOwnProperty.call(dict, key)) el.setAttribute(attr, dict[key]);
      });
    });

    document.querySelectorAll("[data-social]").forEach((el) => {
      const s = dict.social[el.dataset.social];
      if (s) {
        el.dataset.copy = s.copy;
        el.dataset.title = s.title;
      }
    });

    const toggle = document.querySelector("[data-lang-toggle]");
    if (toggle) toggle.textContent = lang === "pt" ? "PT" : "EN";
  }

  function initLang() {
    applyLang(localStorage.getItem("lang") === "en" ? "en" : "pt");
  }

  function initChat() {
    const chat = document.querySelector("[data-msn-chat]");
    if (!chat) return;
    const messages = chat.querySelector("[data-messages]");
    const choices = chat.querySelectorAll("[data-social-choice]");

    choices.forEach((choice) => {
      choice.addEventListener("click", () => {
        const { label, url, domain, title, copy } = choice.dataset;
        if (!label || !url || !domain || !title || !copy || !messages) return;
        const t = i18n[currentLang] || i18n.pt;

        const sent = document.createElement("article");
        sent.className = "message message--sent";
        sent.innerHTML = `<p class="message-meta">${t.youSays}</p><p class="message-line">${label}</p>`;

        const received = document.createElement("article");
        received.className = "message message--received message--link";
        received.innerHTML = `
          <p class="message-meta">${t.daviSays}</p>
          <p class="message-line">${t.hereIs} <a class="message-link" href="${url}" target="_blank" rel="noreferrer">${title}</a></p>
          <p class="message-detail">${copy} — ${domain}</p>`;

        messages.append(sent, received);
        choice.disabled = true;
        const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
        received.scrollIntoView({ behavior: reduceMotion ? "auto" : "smooth", block: "nearest" });
      });
    });
  }

  function initToggle() {
    const toggle = document.querySelector("[data-lang-toggle]");
    if (!toggle) return;
    toggle.addEventListener("click", () => {
      const next = currentLang === "pt" ? "en" : "pt";
      localStorage.setItem("lang", next);
      applyLang(next);
    });
  }

  initLang();
  initChat();
  initToggle();
</script>

<style>
  :global(body) {
    background: #b7d7e8;
  }

  .messenger-page {
    --ink: #243b4a;
    --line: #a9cedc;
    position: relative;
    isolation: isolate;
    min-height: 100vh;
    box-sizing: border-box;
    display: grid;
    place-items: center;
    overflow: hidden;
    padding: 3rem 1rem 4.5rem;
    background:
      radial-gradient(ellipse at 56% 48%, rgb(232 251 255 / 68%) 0 8%, transparent 40%),
      radial-gradient(ellipse at 47% 110%, #7dbbdf 0 15%, transparent 46%),
      linear-gradient(145deg, #174e87 0%, #2f8ac3 38%, #9ad9ef 70%, #2e74a6 100%);
    color: var(--ink);
    font-family: "Segoe UI", Tahoma, Arial, sans-serif;
  }

  .messenger-page::before {
    position: absolute;
    z-index: -1;
    inset: -15%;
    background:
      linear-gradient(27deg, transparent 43%, rgb(255 255 255 / 10%) 43.5%, transparent 48%),
      linear-gradient(151deg, transparent 46%, rgb(199 241 255 / 16%) 46.5%, transparent 51%);
    content: "";
    transform: rotate(-3deg);
  }

  .messenger-window {
    z-index: 1;
    width: min(100%, 44rem);
    height: min(41rem, calc(100vh - 7.5rem));
    min-height: 34rem;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    padding: 0 0.38rem 0.38rem;
    border: 1px solid #285f7f;
    border-radius: 8px 8px 5px 5px;
    background:
      linear-gradient(90deg, rgb(227 248 255 / 84%), rgb(92 185 222 / 72%) 45%, rgb(204 242 253 / 84%)),
      #72beda;
    box-shadow:
      0 0 0 1px rgb(239 252 255 / 82%) inset,
      0 0 0 2px rgb(30 79 108 / 36%),
      0 22px 55px rgb(5 28 51 / 55%),
      0 0 22px rgb(139 222 255 / 32%);
    backdrop-filter: blur(10px) saturate(1.2);
  }

  .window-titlebar {
    height: 1.9rem;
    display: flex;
    flex-shrink: 0;
    align-items: center;
    gap: 0.35rem;
    padding-left: 0.08rem;
    color: #152d3a;
  }

  .window-titlebar p {
    flex: 1;
    margin: 0;
    font-size: 0.75rem;
    font-weight: 600;
    text-shadow: 0 1px white, 0 0 5px white;
  }

  .msn-icon { width: 1.1rem; height: 1rem; flex: 0 0 auto; filter: drop-shadow(0 1px 0 white); }
  .window-controls { height: 1.34rem; display: flex; align-self: flex-start; margin-right: -0.38rem; overflow: hidden; border-radius: 0 0 5px 5px; }
  .window-controls i { position: relative; display: grid; width: 1.85rem; box-sizing: border-box; place-items: center; border: 0; border-bottom: 1px solid #4e839d; border-left: 1px solid rgb(52 104 132 / 55%); background: linear-gradient(#eefaff 0%, #b8ddec 46%, #78b6d0 100%); color: #173c50; font-family: "Segoe UI Symbol", "Segoe UI", sans-serif; font-size: 0.68rem; font-style: normal; text-shadow: 0 1px white; box-shadow: 0 1px 0 rgb(255 255 255 / 90%) inset, -1px 0 rgb(255 255 255 / 42%) inset; }
  .window-controls i::before { position: absolute; inset: 1px 1px 48%; border-radius: 0 0 3px 3px; background: rgb(255 255 255 / 45%); content: ""; }
  .window-controls i::after { position: relative; content: "—"; margin-top: -0.18rem; }
  .window-controls i:first-child { border-radius: 0 0 0 5px; }
  .window-controls i:nth-child(2)::after { content: "□"; margin-top: -0.04rem; font-size: 0.66rem; }
  .window-controls i:last-child { width: 2.85rem; border-color: #8f3732; border-radius: 0 0 5px; background: linear-gradient(#f7c2bd 0%, #df746c 45%, #b43d38 100%); color: white; text-shadow: 0 1px #722d29; box-shadow: 0 1px 0 rgb(255 239 236 / 84%) inset; }
  .window-controls i:last-child::before { background: rgb(255 244 241 / 35%); }
  .window-controls i:last-child::after { content: "×"; margin-top: -0.04rem; font-size: 0.92rem; }

  .messenger-surface {
    min-height: 0;
    flex: 1;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border: 1px solid #416f85;
    background: white;
    box-shadow: 0 0 0 1px rgb(255 255 255 / 68%) inset;
  }

  .messenger-toolbar {
    min-height: 2rem;
    box-sizing: border-box;
    display: flex;
    align-items: center;
    gap: 1rem;
    overflow: hidden;
    padding: 0 0.75rem;
    border-bottom: 1px solid #158eb8;
    background: linear-gradient(#6fd2ed 0%, #37b9e0 46%, #199bc9 100%);
    color: white;
    font-size: 0.72rem;
    white-space: nowrap;
    text-shadow: 0 1px #137598;
    box-shadow: 0 1px rgb(255 255 255 / 55%) inset;
  }

  .contact-bar {
    min-height: 6.8rem;
    box-sizing: border-box;
    display: grid;
    grid-template-columns: 7.1rem minmax(0, 1fr);
    flex-shrink: 0;
    align-items: center;
    padding: 0.55rem 1rem 0.55rem 0.7rem;
    border-bottom: 1px solid #bbdce8;
    background:
      linear-gradient(163deg, transparent 0 45%, rgb(255 255 255 / 47%) 45.5% 48%, transparent 49%),
      radial-gradient(ellipse at 62% 15%, #eafaff 0%, #bce9f5 38%, #7fd1e8 100%);
  }

  .avatar {
    display: grid;
    place-items: center;
    box-sizing: border-box;
    color: #eef8ff;
    font-weight: 600;
    background: linear-gradient(145deg, #b8deea 0%, #638da3 55%, #31566a 100%);
  }

  .avatar--contact {
    width: 5.65rem;
    height: 5.65rem;
    border: 3px solid #79d329;
    border-radius: 7px;
    font-size: 1.05rem;
    box-shadow: 0 0 0 1px #3d6e80, 0 0 0 3px white, 0 4px 9px rgb(31 105 84 / 30%);
  }

  .contact-bar h1 { margin: 0; color: #294251; font-size: 1.08rem; font-weight: 400; line-height: 1.2; text-shadow: 0 1px white; }
  .contact-bar h1 span { font-size: 0.72rem; }
  .contact-bar p { margin: 0.22rem 0 0; color: #425c69; font-size: 0.76rem; }

  .chat-workspace {
    min-height: 0;
    flex: 1;
    display: grid;
    grid-template-columns: 7.1rem minmax(0, 1fr);
    background: #f8fcfe;
  }

  .profile-rail {
    position: relative;
    border-right: 1px solid #bddce7;
    background: linear-gradient(90deg, #eaf7fb, #f8fdff 82%, #d9edf4);
  }

  .rail-handle {
    position: absolute;
    top: 0.45rem;
    left: 0.36rem;
    width: 0.84rem;
    height: 0.84rem;
    display: grid;
    place-items: center;
    border: 1px solid #78a3b4;
    border-radius: 50%;
    background: linear-gradient(white, #cae5ef);
    color: #3e7489;
    font: 700 0.72rem/1 Arial, sans-serif;
  }

  .avatar--self {
    position: absolute;
    right: 0.72rem;
    bottom: 0.95rem;
    width: 5rem;
    height: 5rem;
    border: 2px solid #81cc46;
    border-radius: 6px;
    background: linear-gradient(#f7fcfd, #b8d0d8);
    box-shadow: 0 0 0 1px #5d8290, 0 0 0 3px white, 0 3px 8px rgb(31 76 91 / 22%);
  }

  .avatar--self span::before,
  .avatar--self span::after {
    position: absolute;
    left: 50%;
    background: linear-gradient(#f2f5f6, #9babb1);
    box-shadow: 0 0 0 1px #87999f;
    content: "";
    transform: translateX(-50%);
  }

  .avatar--self span::before { top: 0.78rem; width: 1.42rem; height: 1.42rem; border-radius: 50%; }
  .avatar--self span::after { bottom: 0.68rem; width: 2.9rem; height: 1.8rem; border-radius: 50% 50% 30% 30%; }

  .chat-column {
    min-width: 0;
    min-height: 0;
    display: flex;
    flex-direction: column;
    background: white;
  }

  .conversation { min-height: 8rem; flex: 1; overflow-y: auto; padding: 0.8rem 0.9rem 1rem; background: linear-gradient(#fff, #fff 78%, #f8fcfe); font-family: Tahoma, "Segoe UI", Arial, sans-serif; }
  .conversation-note { margin: 0 0 0.95rem; padding-bottom: 0.45rem; border-bottom: 1px solid #cadde4; color: #6b7d85; font-size: 0.7rem; }
  .conversation :global(.message) { margin-top: 0.55rem; }
  .conversation :global(.message:first-of-type) { margin-top: 0; }
  .conversation :global(.message-meta) { margin: 0; color: #65747b; font-size: 0.74rem; }
  .conversation :global(.message-line) { margin: 0.1rem 0 0; color: #263b46; font-size: 0.78rem; line-height: 1.4; }
  .conversation :global(.message--sent) :global(.message-meta) { color: #397491; }
  .conversation :global(.message-detail) { margin: 0.1rem 0 0; color: #73828a; font-size: 0.68rem; }
  .conversation :global(.message-link) { color: #0066cc; text-decoration: underline; }
