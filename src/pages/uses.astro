---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Uses — Davi Oliveira"
  description="Hardware, software, and tools used by Davi Oliveira."
>
  <div class="page">
    <h1 class="section-heading">Uses</h1>

    <section>
      <h2 class="section-heading">Hardware</h2>
      <p class="body-text">
        Laptop-first setup with external display, mechanical keyboard, and a quiet desk.
      </p>
    </section>

    <hr class="section-divider" />

    <section>
      <h2 class="section-heading">Software</h2>
      <p class="body-text">
        Linux, Hyprland, Neovim, Git, pnpm, Astro, TypeScript, and Cloudflare.
      </p>
    </section>

    <hr class="section-divider" />

    <section>
      <h2 class="section-heading">Workflow</h2>
      <p class="body-text">
        Small branches, conventional commits, test-first slices, and static deploy previews.
      </p>
    </section>
  </div>
</BaseLayout>

<style>
  .body-text {
    color: var(--color-muted);
    line-height: 1.7;
    margin: 0;
  }
</style>
