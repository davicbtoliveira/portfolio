---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Not found — Davi Oliveira"
  description="The requested page could not be found."
>
  <div class="not-found">
    <p class="error-code">404</p>
    <h1>page not found</h1>
    <p>The page you requested does not exist or has moved.</p>
    <a href="/">return home</a>
  </div>
</BaseLayout>

<style>
  .not-found {
    display: grid;
    min-height: 55vh;
    max-width: 52rem;
    margin: 0 auto;
    padding: 4rem 1.5rem;
    place-content: center;
    text-align: center;
    gap: 0.5rem;
  }
  .error-code {
    color: var(--color-accent);
    font-size: 3rem;
    font-weight: 500;
    margin: 0;
  }
  h1 {
    font-size: 1.5rem;
    font-weight: 500;
    margin: 0;
  }
  p {
    color: var(--color-muted);
    margin: 0;
  }
</style>
