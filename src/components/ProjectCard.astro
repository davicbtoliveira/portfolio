---
import type { Project } from "../content/schemas";
import type { GitHubStats } from "../lib/github-enrichment";

type Props = {
  project: Project;
  href: string;
  stats?: GitHubStats;
};

const { project, href, stats } = Astro.props;
---

<article class="project-card">
  <h3>
    <a href={href}>{project.title}</a>
  </h3>
  <p class="summary">{project.summary}</p>
  <p class="meta">
    <span>{project.year}</span>
    <span class="dot">·</span>
    <span>{project.status}</span>
    <span class="dot">·</span>
    <span>{project.role}</span>
    <span class="dot">·</span>
    <span class="tech">{project.tech.join(", ")}</span>
  </p>
  {
    (project.links.repo || project.links.demo || project.links.post) && (
      <p class="links">
        {project.links.repo && <a href={project.links.repo}>Repo</a>}
        {project.links.demo && <a href={project.links.demo}>Demo</a>}
        {project.links.post && <a href={project.links.post}>Post</a>}
      </p>
    )
  }
  {
    stats && (
      <p class="stats">
        <span>{stats.stars} stars</span>
        <span>{stats.forks} forks</span>
        <span>Last commit {new Date(stats.lastCommit).toISOString().slice(0, 10)}</span>
      </p>
    )
  }
</article>

<style>
  .project-card {
    border: 1px solid var(--color-border);
    border-radius: 0.5rem;
    padding: 1.25rem;
    transition: border-color 200ms ease-out;
  }
  .project-card:hover {
    border-color: var(--color-accent);
  }
  h3 {
    margin: 0 0 0.5rem;
    font-size: 1.125rem;
    font-weight: 600;
  }
  h3 a {
    color: var(--color-fg);
    text-decoration: none;
  }
  h3 a:hover {
    color: var(--color-accent);
  }
  .summary {
    color: var(--color-muted);
    font-size: 0.9375rem;
    margin: 0 0 0.75rem;
  }
  .meta {
    color: var(--color-muted);
    font-size: 0.8125rem;
    font-family: var(--font-mono);
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .dot {
    opacity: 0.5;
  }
  .links {
    display: flex;
    gap: 0.75rem;
    margin: 1rem 0 0;
  }
  .links a {
    color: var(--color-accent);
    font-size: 0.875rem;
  }
  .stats {
    color: var(--color-muted);
    display: flex;
    flex-wrap: wrap;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    gap: 0.75rem;
    margin: 1rem 0 0;
  }
</style>
