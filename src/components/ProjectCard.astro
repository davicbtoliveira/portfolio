---
import type { Project } from "../content/schemas";

type Props = {
  project: Project;
  href: string;
};

const { project, href } = Astro.props;
---

<article class="project-card">
  <h3>
    <a href={href}>{project.title}</a>
  </h3>
  <p class="summary">{project.summary}</p>
  <p class="meta">
    <span>{project.year}</span>
    <span class="dot">·</span>
    <span class="tech">{project.tech.join(", ")}</span>
  </p>
</article>

<style>
  .project-card {
    border: 1px solid var(--color-border);
    border-radius: 0.5rem;
    padding: 1.25rem;
    transition: border-color 200ms ease-out;
  }
  .project-card:hover {
    border-color: var(--color-accent);
  }
  h3 {
    margin: 0 0 0.5rem;
    font-size: 1.125rem;
    font-weight: 600;
  }
  h3 a {
    color: var(--color-fg);
    text-decoration: none;
  }
  h3 a:hover {
    color: var(--color-accent);
  }
  .summary {
    color: var(--color-muted);
    font-size: 0.9375rem;
    margin: 0 0 0.75rem;
  }
  .meta {
    color: var(--color-muted);
    font-size: 0.8125rem;
    font-family: var(--font-mono);
    margin: 0;
    display: flex;
    gap: 0.5rem;
  }
  .dot {
    opacity: 0.5;
  }
</style>
