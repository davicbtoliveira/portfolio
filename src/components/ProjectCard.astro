---
import type { Project } from "../content/schemas";
import type { GitHubStats } from "../lib/github-enrichment";

type Props = {
  project: Project;
  href: string;
  stats?: GitHubStats;
};

const { project, href, stats } = Astro.props;
---

<article class="project-entry" data-status={project.status} data-tech={project.tech.join(",")}>
  <h3><a href={href}>{project.title}</a></h3>
  <p class="summary">{project.summary}</p>
  <p class="meta">
    <span>{project.tech.join(", ")}</span>
    <span aria-hidden="true"> · </span>
    <span>{project.year}</span>
    <span aria-hidden="true"> · </span>
    <span>{project.status}</span>
    <span aria-hidden="true"> · </span>
    <span>{project.role}</span>
    {
      stats && (
        <>
          <span aria-hidden="true"> · </span>
          <span class="stats">{stats.stars}★</span>
        </>
      )
    }
  </p>
  {
    (project.links.repo || project.links.demo || project.links.post) && (
      <p class="links">
        {project.links.repo && <a href={project.links.repo}>repo</a>}
        {project.links.demo && <a href={project.links.demo}>demo</a>}
        {project.links.post && <a href={project.links.post}>post</a>}
      </p>
    )
  }
</article>
