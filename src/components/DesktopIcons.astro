---
const desktopIcons = [
  { id: "computer", label: "Computer" },
  { id: "userfiles", label: "User's Files" },
  { id: "network", label: "Network" },
  { id: "recyclebin", label: "Recycle Bin" },
  { id: "ie", label: "Internet Explorer" },
];
---

<div class="win7-desktop" data-win7-desktop aria-label="Desktop icons">
  {
    desktopIcons.map((icon) => (
      <button type="button" class="desktop-icon" data-desktop-icon aria-label={icon.label}>
        <span class="icon-glyph" aria-hidden="true">
          {icon.id === "computer" && (
            <svg viewBox="0 0 48 48" class="ico">
              <defs>
                <linearGradient id="mon-bezel" x1="0" y1="0" x2="0" y2="1">
                  <stop offset="0" stop-color="#d3dade" />
                  <stop offset="1" stop-color="#8b9298" />
                </linearGradient>
                <linearGradient id="mon-screen" x1="0" y1="0" x2="0" y2="1">
                  <stop offset="0" stop-color="#48a9ec" />
                  <stop offset="1" stop-color="#0b5cab" />
                </linearGradient>
              </defs>
              <rect x="20" y="37" width="8" height="5" fill="#9aa1a8" />
              <rect x="14" y="41" width="20" height="4" rx="2" fill="#bcc3c9" />
              <rect x="6" y="6" width="36" height="30" rx="3" fill="url(#mon-bezel)" stroke="#6f757b" stroke-width="0.8" />
              <rect x="9" y="9" width="30" height="24" rx="1.5" fill="url(#mon-screen)" />
              <rect x="11" y="11" width="13" height="8" rx="1" fill="#cdeafb" opacity="0.5" />
            </svg>
          )}
          {icon.id === "recyclebin" && (
            <svg viewBox="0 0 48 48" class="ico">
              <defs>
                <linearGradient id="bin-body" x1="0" y1="0" x2="0" y2="1">
                  <stop offset="0" stop-color="#cdeef5" />
                  <stop offset="1" stop-color="#5fb8cf" />
                </linearGradient>
              </defs>
              <rect x="12" y="10" width="24" height="5" rx="2.5" fill="#82c9da" stroke="#4390a4" stroke-width="0.6" />
              <rect x="20" y="6" width="8" height="4" rx="2" fill="#82c9da" stroke="#4390a4" stroke-width="0.6" />
              <path d="M14 16 h20 l-2 26 a2 2 0 0 1 -2 2 h-12 a2 2 0 0 1 -2 -2 z" fill="url(#bin-body)" stroke="#3f93a8" stroke-width="0.8" />
              <line x1="20" y1="18" x2="19" y2="42" stroke="#3f93a8" stroke-width="0.8" opacity="0.55" />
              <line x1="24" y1="18" x2="24" y2="42" stroke="#3f93a8" stroke-width="0.8" opacity="0.55" />
              <line x1="28" y1="18" x2="29" y2="42" stroke="#3f93a8" stroke-width="0.8" opacity="0.55" />
            </svg>
          )}
          {icon.id === "userfiles" && (
            <svg viewBox="0 0 48 48" class="ico">
              <defs>
                <linearGradient id="folder" x1="0" y1="0" x2="0" y2="1">
                  <stop offset="0" stop-color="#ffe07a" />
                  <stop offset="1" stop-color="#f4b400" />
                </linearGradient>
              </defs>
              <path d="M6 14 h12 l4 5 h20 a2 2 0 0 1 2 2 v17 a2 2 0 0 1 -2 2 H6 a2 2 0 0 1 -2 -2 V16 a2 2 0 0 1 2 -2 z" fill="url(#folder)" stroke="#d99a00" stroke-width="0.8" />
              <circle cx="24" cy="28" r="7" fill="#2f6fb0" opacity="0.92" />
              <circle cx="24" cy="25.5" r="2.3" fill="#fff" />
              <path d="M20.2 31 a3.8 3.8 0 0 1 7.6 0 z" fill="#fff" />
            </svg>
          )}
          {icon.id === "network" && (
            <svg viewBox="0 0 48 48" class="ico">
              <defs>
                <radialGradient id="globe" cx="40%" cy="35%" r="72%">
                  <stop offset="0" stop-color="#86d4ff" />
                  <stop offset="1" stop-color="#0d6fb8" />
                </radialGradient>
              </defs>
              <rect x="8" y="8" width="32" height="24" rx="3" fill="#e0e7eb" stroke="#9aa1a8" stroke-width="0.8" />
              <rect x="11" y="11" width="26" height="18" rx="1.5" fill="url(#globe)" />
              <ellipse cx="24" cy="20" rx="6" ry="9" fill="none" stroke="#fff" stroke-width="0.8" opacity="0.7" />
              <line x1="11" y1="20" x2="37" y2="20" stroke="#fff" stroke-width="0.8" opacity="0.7" />
              <rect x="21" y="32" width="6" height="4" fill="#9aa1a8" />
              <rect x="15" y="36" width="18" height="4" rx="2" fill="#bcc3c9" />
            </svg>
          )}
          {icon.id === "ie" && (
            <svg viewBox="0 0 48 48" class="ico">
              <defs>
                <linearGradient id="ie-e" x1="0" y1="0" x2="0" y2="1">
                  <stop offset="0" stop-color="#46aeeb" />
                  <stop offset="1" stop-color="#0a66b0" />
                </linearGradient>
              </defs>
              <circle cx="24" cy="24" r="18" fill="url(#ie-e)" stroke="#0a4f8a" stroke-width="0.8" />
              <text x="24" y="33" font-family="Georgia, 'Times New Roman', serif" font-size="26" font-weight="700" fill="#fff" text-anchor="middle">e</text>
              <path d="M10 16 q14 -8 28 4 q-12 -2 -22 6 q10 2 16 8" fill="none" stroke="#ffd400" stroke-width="3" stroke-linecap="round" opacity="0.9" />
            </svg>
          )}
        </span>
        <span class="desktop-icon-label">{icon.label}</span>
      </button>
    ))
  }
</div>

<script is:inline>
  const desktop = document.querySelector("[data-win7-desktop]");
  if (desktop) {
    const icons = Array.from(desktop.querySelectorAll("[data-desktop-icon]"));
    const page = document.querySelector(".messenger-page");

    icons.forEach((icon) => {
      icon.addEventListener("click", (event) => {
        event.stopPropagation();
        const wasSelected = icon.classList.contains("selected");
        icons.forEach((other) => other.classList.remove("selected"));
        if (!wasSelected) icon.classList.add("selected");
      });
    });

    page?.addEventListener("click", () => {
      icons.forEach((other) => other.classList.remove("selected"));
    });
  }
</script>

<style>
  .win7-desktop {
    position: absolute;
    top: 0.4rem;
    left: 0.4rem;
    z-index: 3;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    padding: 0.1rem;
  }

  .desktop-icon {
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 78px;
    margin: 0;
    padding: 4px 2px 2px;
    border: 0;
    border-radius: 2px;
    background: none;
    color: #fff;
    font-family: "Segoe UI", Tahoma, Arial, sans-serif;
    text-align: center;
    cursor: pointer;
  }

  .icon-glyph {
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border-radius: 4px;
  }

  .icon-glyph .ico {
    width: 48px;
    height: 48px;
    display: block;
  }

  .desktop-icon-label {
    margin-top: 3px;
    max-width: 74px;
    padding: 1px 3px;
    border-radius: 2px;
    font-size: 11px;
    line-height: 1.15;
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.85);
  }

  .desktop-icon:focus-visible {
    outline: 1px dotted #fff;
    outline-offset: -1px;
  }

  .desktop-icon.selected .icon-glyph {
    background: rgba(11, 65, 151, 0.55);
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.45);
  }

  .desktop-icon.selected .desktop-icon-label {
    background: linear-gradient(#316ac5, #4a8bf0);
    text-shadow: none;
  }

  @media (max-width: 38rem) {
    .win7-desktop {
      display: none;
    }
  }
</style>
