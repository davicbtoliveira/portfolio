---
type Props = {
  name: string;
  tagline: string;
};

const { name, tagline } = Astro.props;
---

<section class="hero">
  <div class="terminal-line">
    <span class="terminal-prompt">~ $</span>
    <span class="typewriter-wrapper">
      <span class="typewriter-text">whoami</span>
      <span class="typewriter-cursor" aria-hidden="true"></span>
    </span>
  </div>
  <div class="whoami-response">
    <h1>{name}</h1>
    <p>{tagline}</p>
  </div>
</section>

<style>
  .hero {
    padding: 1.5rem 0 0.5rem;
  }
  .terminal-line {
    font-size: 0.9375rem;
  }
</style>
