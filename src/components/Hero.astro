---
type Props = {
  name: string;
  tagline: string;
};

const { name, tagline } = Astro.props;
---

<section class="hero">
  <h1>{name}</h1>
  <p>{tagline}</p>
</section>

<style>
  .hero {
    padding: 4rem 1.5rem;
    max-width: 42rem;
    margin: 0 auto;
  }
  h1 {
    font-size: 2.25rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    margin: 0 0 0.5rem;
  }
  p {
    font-size: 1.125rem;
    color: var(--color-muted);
    margin: 0;
  }
</style>
