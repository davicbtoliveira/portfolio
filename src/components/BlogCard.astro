---
import type { Post } from "../content/schemas";

type Props = {
  post: Post;
  href: string;
};

const { post, href } = Astro.props;

const formatter = new Intl.DateTimeFormat("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
});
const formattedDate = formatter.format(post.pubDate);
---

<article class="post-card">
  <h3>
    <a href={href}>{post.title}</a>
  </h3>
  <p class="description">{post.description}</p>
  <p class="meta">
    <time datetime={post.pubDate.toISOString()}>{formattedDate}</time>
  </p>
</article>

<style>
  .post-card {
    border: 1px solid var(--color-border);
    border-radius: 0.5rem;
    padding: 1.25rem;
    transition: border-color 200ms ease-out;
  }
  .post-card:hover {
    border-color: var(--color-accent);
  }
  h3 {
    margin: 0 0 0.5rem;
    font-size: 1.125rem;
    font-weight: 600;
  }
  h3 a {
    color: var(--color-fg);
    text-decoration: none;
  }
  h3 a:hover {
    color: var(--color-accent);
  }
  .description {
    color: var(--color-muted);
    font-size: 0.9375rem;
    margin: 0 0 0.75rem;
  }
  .meta {
    color: var(--color-muted);
    font-size: 0.8125rem;
    font-family: var(--font-mono);
    margin: 0;
  }
</style>
