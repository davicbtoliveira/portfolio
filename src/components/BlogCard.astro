---
import type { Post } from "../content/schemas";

type Props = {
  post: Post;
  href: string;
};

const { post, href } = Astro.props;

const formatter = new Intl.DateTimeFormat("en-US", {
  year: "numeric",
  month: "short",
  day: "2-digit",
});
const formattedDate = formatter.format(post.pubDate);
---

<article class="post-entry" data-tags={post.tags.join(",")}>
  <span class="date">{formattedDate}</span>
  <div class="info">
    <a href={href} class="title">{post.title}</a>
    {post.description && <p class="description">{post.description}</p>}
  </div>
</article>
