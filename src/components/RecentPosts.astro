---
import type { PostEntry } from "../content/schemas";
import BlogCard from "./BlogCard.astro";

type Props = {
  posts: PostEntry[];
};

const { posts } = Astro.props;
---

{
  posts.length > 0 && (
    <section class="recent-posts">
      <h2>Recent Posts</h2>
      <div class="grid">
        {posts.map((entry) => (
          <BlogCard post={entry.data} href={`/blog/${entry.id}`} />
        ))}
      </div>
    </section>
  )
}

<style>
  .recent-posts {
    max-width: 64rem;
    margin: 0 auto;
    padding: 2rem 1.5rem;
  }
  h2 {
    font-size: 1.5rem;
    font-weight: 600;
    margin: 0 0 1.5rem;
    letter-spacing: -0.01em;
  }
  .grid {
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(auto-fill, minmax(18rem, 1fr));
  }
</style>
