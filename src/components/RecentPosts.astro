---
import type { PostEntry } from "../content/schemas";
import BlogCard from "./BlogCard.astro";

type Props = {
  posts: PostEntry[];
};

const { posts } = Astro.props;
---

{
  posts.length > 0 && (
    <section>
      <h2 class="section-heading">Recent Posts</h2>
      <div>
        {posts.map((entry) => (
          <BlogCard post={entry.data} href={`/blog/${entry.id}`} />
        ))}
      </div>
    </section>
  )
}
